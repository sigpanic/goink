#!/bin/sh
# Conventional Commits enforcement hook
#
# Setup: git config --local core.hooksPath .githooks
#
# Format: <type>(<optional-scope>): <description>
#
# Types: feat fix docs style refactor perf test build ci chore revert
#
# Examples:
#   feat: add novel import with EPUB/TXT/MD parsers
#   fix: detect empty SSE response to prevent silent chat failure
#   refactor(style): migrate from filesystem to SQLite with pagination
#   docs: update error handling audit with completed fixes

commit_msg=$(cat "$1")

# Skip merge / rebase / revert commits (generated by git itself)
if echo "$commit_msg" | head -1 | grep -qE '^(Merge |Revert "|Squash|Amend)'; then
    exit 0
fi

# Extract the first line
first_line=$(echo "$commit_msg" | head -1)

# Valid types
types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Conventional Commits pattern:
#   type(scope): description   OR   type: description
# Scope is optional, any non-parenthesis characters (allows app/setting, mcp/preference, etc).
# Description must be non-empty (at least one non-whitespace character after the colon).
pattern="^(${types})(\([^)]+\))?: .+"

if ! echo "$first_line" | grep -qE "$pattern"; then
    cat >&2 <<'EOF'

  ✖ Commit message does not follow Conventional Commits format.

  Expected format:
    <type>(<optional-scope>): <description>

  Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

  Examples:
    feat: add novel import with EPUB/TXT/MD parsers
    fix(ui): correct sidebar resize glitch
    refactor(style): migrate from filesystem to SQLite
    docs: update error handling audit

EOF
    exit 1
fi

# Require blank line between subject and body
line_count=$(echo "$commit_msg" | wc -l)
if [ "$line_count" -gt 1 ]; then
    second_line=$(echo "$commit_msg" | sed -n '2p')
    if [ -n "$second_line" ]; then
        cat >&2 <<'EOF'

  ✖ The second line of your commit message must be blank.
    Add a blank line between the subject and body.

    Correct:
      feat: short description

      Detailed body here.

EOF
        exit 1
    fi
fi

# Require body (subject line alone is not enough; need non-empty content
# after the blank line). line_count == 1 means only subject; line_count
# == 2 means subject + blank line but no body content. Merge/revert were
# already skipped above so they are unaffected.
if [ "$line_count" -le 2 ]; then
    cat >&2 <<'EOF'

  ✖ Commit message must include a body explaining what and why.
    Subject line alone is not enough; add a blank line then the body.

    Correct:
      feat: short description

      Detailed body explaining what changed and why.

EOF
    exit 1
fi

exit 0
