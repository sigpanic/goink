// This adapter is compiled against the selected release's unmodified source and
// go.mod. It creates no schema itself: all DDL belongs to that release's Run.
package main

import (
	"encoding/json"
	"fmt"
	"log/slog"
	"os"
	"os/exec"
	"path/filepath"
	"strings"

	"{{.}}/internal/config"
	"{{.}}/internal/llm"
	"{{.}}/internal/migrate"
	"{{.}}/internal/platform"
	"{{.}}/internal/storage"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	if len(os.Args) != 3 || (os.Args[1] != "seed" && os.Args[1] != "upgrade") {
		return fmt.Errorf("usage: runner seed|upgrade metadata.json")
	}
	log := slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelError}))
	config.Set(&config.AppConfig{})
	if filepath.Clean(platform.DataDir()) != filepath.Join(os.Getenv("HOME"), "Goink") {
		return fmt.Errorf("historical data directory was not isolated")
	}
	if filepath.Clean(config.LLMConfigPath()) != filepath.Join(os.Getenv("HOME"), ".goink", "llm_config.enc") {
		return fmt.Errorf("historical config directory was not isolated")
	}
	if err := os.MkdirAll(platform.DataDir(), 0755); err != nil {
		return err
	}
	metadataPath := os.Args[2]
	// Expected counts are supplied by the seed, never recomputed from the result
	// of a historical upgrade (which would bless historical data corruption).
	data, err := os.ReadFile(metadataPath)
	if err != nil {
		return err
	}
	meta := map[string]any{}
	if err := json.Unmarshal(data, &meta); err != nil {
		return err
	}
	db, err := storage.Open(config.GlobalDBPath(), log)
	if err != nil {
		return err
	}
	closed := false
	defer func() {
		if !closed {
			_ = storage.Close(db)
		}
	}()
	if err := migrate.Run(db, log); err != nil {
		return err
	}
	if os.Args[1] == "seed" {
		encoded, err := os.ReadFile(filepath.Join(filepath.Dir(metadataPath), "seed.json"))
		if err != nil {
			return err
		}
		var input SeedData
		if err := json.Unmarshal(encoded, &input); err != nil {
			return err
		}
		for _, row := range input.Rows {
			if err := db.Table(row.Table).Create(row.Values).Error; err != nil {
				return fmt.Errorf("seed %s: %w", row.Table, err)
			}
		}
		path := config.LLMConfigPath()
		if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
			return err
		}
		var cfg llm.UserLLMConfig
		if err := json.Unmarshal(input.LLMConfig, &cfg); err != nil {
			return err
		}
		if err := llm.SaveUserConfig(path, &cfg); err != nil {
			return err
		}
		for name, content := range input.Files {
			clean := filepath.Clean(filepath.FromSlash(name))
			if filepath.IsAbs(clean) || clean == ".." || strings.HasPrefix(clean, ".."+string(filepath.Separator)) {
				return fmt.Errorf("invalid seed path %s", name)
			}
			path := filepath.Join(platform.DataDir(), clean)
			if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
				return err
			}
			if err := os.WriteFile(path, []byte(content), 0644); err != nil {
				return err
			}
		}
		for _, row := range input.Rows {
			if row.Table != "novels" {
				continue
			}
			id := int64(row.Values["id"].(float64))
			dir := config.NovelDirPath(id)
			if err := os.MkdirAll(dir, 0755); err != nil {
				return err
			}
			for _, args := range [][]string{
				{"init", "-b", "main"},
				{"config", "user.name", "Upgrade Fixture"},
				{"config", "user.email", "fixture@goink.local"},
				{"config", "core.autocrlf", "false"},
				{"add", "-A"},
				{"commit", "--allow-empty", "-m", "test: freeze historical upgrade input", "-m", "Preserve declared seed files as the starting history for migration verification."},
			} {
				if _, err := runGit(dir, args...); err != nil {
					return err
				}
			}
		}
	}
	if _, err := os.Stat(config.LLMConfigPath()); err != nil {
		return err
	}
	if _, err := llm.LoadUserConfig(config.LLMConfigPath()); err != nil {
		return fmt.Errorf("historical LLM config: %w", err)
	}
	var novels []struct{ ID int64 }
	if err := db.Table("novels").Order("id").Find(&novels).Error; err != nil {
		return err
	}
	heads := map[string]string{}
	for _, novel := range novels {
		out, err := runGit(config.NovelDirPath(novel.ID), "rev-parse", "HEAD")
		if err != nil {
			return err
		}
		heads[fmt.Sprint(novel.ID)] = strings.TrimSpace(out)
	}
	meta["git_heads"] = heads
	data, err = json.MarshalIndent(meta, "", "  ")
	if err != nil {
		return err
	}
	if err := storage.Close(db); err != nil {
		return err
	}
	closed = true
	return os.WriteFile(metadataPath, data, 0644)
}

func runGit(dir string, args ...string) (string, error) {
	cmd := exec.Command("git", args...)
	cmd.Dir = dir
	out, err := cmd.CombinedOutput()
	if err != nil {
		return "", fmt.Errorf("fixture git %v: %w: %s", args, err, out)
	}
	return string(out), nil
}
